name: cherry
title: Cherry
base: core24
version: "$RELEASE_VERSION"
summary: An Unreal Engine IDE built on Zed
description: |
  Cherry is an Unreal Engine IDE built on Zed, featuring GPU-accelerated
  rendering and deep integration with Unreal Engine workflows.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/kasaiarashi/cherry
source-code: https://github.com/kasaiarashi/cherry
issues: https://github.com/kasaiarashi/cherry/issues
contact: https://github.com/kasaiarashi/cherry

parts:
  cherry:
    plugin: dump
    source: "https://github.com/kasaiarashi/cherry/releases/download/v$RELEASE_VERSION/cherry-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Cherry exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in blade_graphics.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Cherry exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  cherry:
    command: usr/bin/cherry
    common-id: kriaa.kasaiarashi.Cherry
    environment:
      CHERRY_BUNDLE_TYPE: snap
