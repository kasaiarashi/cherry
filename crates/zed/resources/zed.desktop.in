[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=Text Editor
Comment=An Unreal Engine IDE built on Zed.
TryExec=$APP_CLI
StartupNotify=$DO_STARTUP_NOTIFY
Exec=$APP_CLI $APP_ARGS
Icon=$APP_ICON
Categories=Utility;TextEditor;Development;IDE;
Keywords=cherry;unreal;
# To add Cherry to "Open Folder With..." context menu, add `inode/directory` to the MimeType field (semicolon separated)
MimeType=text/plain;application/x-zerosize;x-scheme-handler/cherry;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec=$APP_CLI --new $APP_ARGS
Name=Open a new workspace
